{
  "Routes": [

    // 🔹 AUTH SWAGGER FIRST
    {
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-service-41lf.onrender.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/auth/swagger/{everything}",
      "UpstreamHttpMethod": [ "GET" ]
    },

    // 🔹 PRODUCT SWAGGER
    {
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service-ow6k.onrender.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/products/swagger/{everything}",
      "UpstreamHttpMethod": [ "GET" ]
    },

    // 🔹 AUTH API
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth-service-41lf.onrender.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // 🔹 PRODUCT API
    {
      "DownstreamPathTemplate": "/api/products/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "product-service-ow6k.onrender.com",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/products/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://api-gateway-1bzz.onrender.com"
  }
}